static void tp_num_hex(const char *label, unsigned v, int digits) {
    char num[16];
    LOG(label);
    if (digits == 2) u2hex(v, 2, num); else u2hex(v, digits, num);
    LOG(num);
    LOG("\n");
}

/* Reference renderer: rectangles only, no font table involved. */
static void tp_draw_ref(int x, int y, const char *s, int color) {
    rgbSetColor(color);
    for (; *s; ++s, x += 6) {
        unsigned char c = (unsigned char)*s;
        if (c < 0x20 || c > 0x7E) c = '?';
        const unsigned char *g = TP_FONT5X7[c - 0x20];
        for (int row = 0; row < 7; ++row)
            for (int col = 0; col < 5; ++col)
                if (g[col] & (1 << (6 - row)))
                    FillRect((short)(x + col), (short)(y + row), (short)(x + col), (short)(y + row), 0);
    }
}

static void text_probe(void) {
    LOG("tp: begin\n");

    fill_rect(0, 0, SCREEN_W, SCREEN_H, COL_BG);
    fill_rect(0, 0, SCREEN_W, 18, COL_HEAD);
    LOG("tp: fill ok\n");

    tp_draw_ref(2, 22, "REF5x7 OK", COL_TX);
    LOG("tp: ref redraw ok\n");

    {
        int w = text_width("TE");
        tp_num_hex("tp: width TE=", (unsigned)w, 2);
    }
    LOG("tp: width ok\n");

    draw_text(2, 42, "TE", COL_TX);
    LOG("tp: ascii draw ok\n");

#ifndef FM_NO_CJK
    draw_text(2, 60, "\xE9\xA1\xB9", COL_TX); /* U+9879 */
    LOG("tp: cjk draw ok\n");
#endif

    {
        char out[MAX_PATH];
        fit_text("C:\\VERY_LONG_DIRECTORY_NAME_FOR_FITTING", 60, "~", out, sizeof(out));
        draw_text(2, 80, out, COL_TX);
    }
    LOG("tp: fit ok\n");
    LOG("tp: all text steps ok\n");
    for (;;) OSSleep(1000);
}
